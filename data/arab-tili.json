  {
    "id": "jumla-tuzilishi",
    "sarlavha": "Oddiy jumla tuzilishi",
    "daraja": "O'rta",
    "kirish": "Arab tilida ismli jumla (al-jumlatul-ismiyya) mubtado (ega) va xabar (kesim)dan tashkil topadi.",
    "boblar": [
      { "sarlavha": "Ismli jumla", "matn": "Masalan: البَيْتُ كَبِيرٌ — \"Uy katta\". Bu yerda البَيْتُ (uy) — mubtado, كَبِيرٌ (katta) — xabar." },
      { "sarlavha": "Fe'lli jumla", "matn": "Fe'l bilan boshlanadigan jumla al-jumlatul-fi'liyya deyiladi. Masalan: ذَهَبَ الْوَلَدُ إِلَى الْمَدْرَسَةِ — \"Bola maktabga bordi\"." },
      { "sarlavha": "Bog'lovchi bo'lmasligi", "matn": "Arab tilida hozirgi zamonda \"bo'lmoq\" fe'li (masalan \"u shifokordir\") odatda alohida so'z bilan ifodalanmaydi, jumla to'g'ridan-to'g'ri ot va sifat bilan tuziladi." }
    ]
  }
