  {
    "id": "harakatlar",
    "sarlavha": "Harakatlar (unli belgilar)",
    "daraja": "Boshlang'ich",
    "kirish": "Arab yozuvida unli tovushlar harf ustiga yoki ostiga qo'yiladigan maxsus belgilar — harakatlar orqali ifodalanadi.",
    "boblar": [
      { "sarlavha": "Fatha ( ََ )", "matn": "Harf ustiga qo'yiladigan qiyshiq chiziqcha, \"a\" tovushini bildiradi. Masalan: بَ — \"ba\"." },
      { "sarlavha": "Kasra ( ِِ )", "matn": "Harf ostiga qo'yiladigan chiziqcha, \"i\" tovushini bildiradi. Masalan: بِ — \"bi\"." },
      { "sarlavha": "Damma ( ُُ )", "matn": "Harf ustiga qo'yiladigan kichik vov belgisi, \"u\" tovushini bildiradi. Masalan: بُ — \"bu\"." },
      { "sarlavha": "Sukun ( ْْ )", "matn": "Harfda unli tovush yo'qligini bildiradi, ya'ni harf tovushsiz (jarangsiz) o'qiladi. Masalan: بْ — \"b\"." },
      { "sarlavha": "Shadda ( ّّ )", "matn": "Harf ikki marta, qo'shaloq talaffuz qilinishini bildiradi. Masalan: بّ — \"bb\"." }
    ]
  },
  {
